options:
  parameters: {author: 'Grupo E1 - Rincon, Veloza, Torres', catch_exceptions: 'True', category: '[GRC Hier Blocks]', cmake_opt: '', comment: '', copyright: '', description: 'Fase 2: Tx BFSK / canal AWGN + interferencia / Rx no coherente y BER', gen_cmake: 'On', gen_linking: dynamic, generate_options: qt_gui, hier_block_src_path: '.:', id: FSK_TxRx_Interferencia, max_nouts: '0', output_language: python, placement: '(0,0)', qt_qss_theme: '', realtime_scheduling: '', run: 'True', run_command: '{python} -u {filename}', run_options: prompt, sizing_mode: fixed, thread_safe_setters: '', title: 'FSK Tx-Canal-Rx con AWGN e interferencia (Fase 2, E1)', window_size: '(1400,900)'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled
blocks:
- name: samp_rate
  id: variable
  parameters: {comment: samp_rate = Rb*sps = 480 kHz, value: Rb*sps}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 8]
    rotation: 0
    state: enabled
- name: Rb
  id: variable
  parameters: {comment: 'Fase 1 (E1): Rb = 4.8 kbps (BFSK: Rs = Rb)', value: '4800'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [320, 8]
    rotation: 0
    state: enabled
- name: sps
  id: variable
  parameters: {comment: '', value: '100'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [420, 8]
    rotation: 0
    state: enabled
- name: fsk_deviation
  id: variable
  parameters: {comment: 'Fase 1 (E1): desviacion de frecuencia 20 kHz

      marca = +df, espacio = -df', value: 20e3}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [520, 8]
    rotation: 0
    state: enabled
- name: noise_amp
  id: variable
  parameters: {comment: 'Potencia de la senal = 1 (envolvente constante)

      Eb/N0 = (1/Rb)/(sigma^2/samp_rate) = sps/sigma^2', value: math.sqrt(sps/(10**(EbN0_dB/10.0)))}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [200, 96]
    rotation: 0
    state: enabled
- name: A_int
  id: variable
  parameters: {comment: Amplitud del tono interferente (P_s = 1), value: int_on*10**(-SIR_dB/20.0)}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [420, 96]
    rotation: 0
    state: enabled
- name: ber_len
  id: variable
  parameters: {comment: Ventana de promediado del BER (bits), value: '20000'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [600, 96]
    rotation: 0
    state: enabled
- name: EbN0_dB
  id: variable_qtgui_range
  parameters: {comment: '', label: '"Eb/N0 (dB)"', value: '10', start: '-2', stop: '20', step: '0.5', widget: counter_slider, rangeType: float, orient: QtCore.Qt.Horizontal, min_len: '200', gui_hint: '0,0,1,1'}
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [760, 8]
    rotation: 0
    state: enabled
- name: int_on
  id: variable_qtgui_check_box
  parameters: {comment: '', label: '"Interferencia co-canal (tono)"', type: int, value: '0', 'true': '1', 'false': '0', gui_hint: '1,0,1,1'}
  states:
