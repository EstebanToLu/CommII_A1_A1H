- name: epy_block_0_0_0
  id: epy_block
  parameters:
    _source_code: "import numpy as np\nfrom gnuradio import gr\n\n\nclass blk(gr.sync_block):\n\
      \    def __init__(self):\n        super().__init__(\n            name='e_Acum',\n\
      \            in_sig=[np.float32],\n            out_sig=[np.float32]\n      \
      \  )\n        self.acum_anterior = 0.0\n\n    def work(self, input_items, output_items):\n\
      \        x = input_items[0]\n        y0 = output_items[0]\n\n        acumulado\
      \ = self.acum_anterior + np.cumsum(x)\n        y0[:] = acumulado\n        self.acum_anterior\
      \ = acumulado[-1]\n\n        return len(y0)"
    affinity: ''
    alias: ''
    comment: ''
    maxoutbuf: '0'
    minoutbuf: '0'
  states:
    _io_cache: ('e_Acum', 'blk', [], [('0', 'float', 1)], [('0', 'float', 1)], '',
      [])
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [696, 440.0]
    rotation: 0
    state: enabled
